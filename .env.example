# 环境变量示例，复制为 .env 后按需修改

# 服务
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=si_land_server=debug,tower_http=debug
DB_MAX_CONNECTIONS=8

# PostgreSQL（必填，无默认值）
DATABASE_URL=postgres://siland:siland123@localhost:5432/siland

# JWT（必填，无默认值，生产环境务必修改）
JWT_SECRET=please-change-me-in-production
JWT_EXPIRES_HOURS=168

# 短信验证码
SMS_CODE_EXPIRE_IN=300
SMS_CODE_RESEND_COOLDOWN=60
SMS_CODE_LENGTH=6
DEFAULT_USER_NICKNAME=硅基星球用户
# 固定验证码（mock 联调用）；留空则随机生成
MOCK_FIXED_CODE=1234

# 管理员后台账号（vue-vben-admin 登录，生产环境务必修改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 抖音接口
DOUYIN_HTTP_TIMEOUT_SECS=10
DOUYIN_MAX_REDIRECTS=3
# 以下有合理默认值，通常无需修改
# DOUYIN_USER_AGENT=...
# DOUYIN_REFERER=https://live.douyin.com/
# DOUYIN_TTWID_REGISTER_URL=https://ttwid.bytedance.com/ttwid/union/register/
# DOUYIN_ENTER_API_URL=https://live.douyin.com/webcast/room/web/enter/

# 轮询调度
POLL_LOOP_INTERVAL_SECS=3
POLL_BATCH_SIZE=20
POLL_MAX_CONCURRENCY=4
POLL_CHECK_TIMEOUT_SECS=10
POLL_INTERVAL_LIVE_SECS=60
POLL_INTERVAL_IDLE_SECS=120
POLL_BACKOFF_BASE_SECS=60
POLL_BACKOFF_MAX_SECS=1800
POLL_JITTER_SECS=15

# 推送
PUSH_DEFAULT_CHANNEL=bark
PUSH_BARK_BASE_URL=https://api.day.app
PUSH_TIMEOUT_SECS=5
