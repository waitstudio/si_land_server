# 环境变量示例，复制为 .env 后按需修改
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=si_land_server=debug,tower_http=debug

# PostgreSQL
POSTGRES_USER=siland
POSTGRES_PASSWORD=siland123
POSTGRES_DB=siland
POSTGRES_PORT=5432
DATABASE_URL=postgres://siland:siland123@localhost:5432/siland

# Redis
REDIS_PASSWORD=siland123
REDIS_PORT=6379
REDIS_URL=redis://:siland123@localhost:6379/0

# JWT
JWT_SECRET=please-change-me-in-production
JWT_EXPIRES_HOURS=168

# 短信验证码
SMS_CODE_EXPIRE_IN=300
SMS_CODE_RESEND_COOLDOWN=60
# 固定验证码（mock 联调用）；留空则随机生成 6 位
MOCK_FIXED_CODE=1234
